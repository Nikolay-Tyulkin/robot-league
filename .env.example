# Optional build-time override; leave empty for same-origin /ws.
NEXT_PUBLIC_GAME_SERVER_URL=
HOST=127.0.0.1
PORT=8080
# Blank uses same-origin WebSocket validation. For a reverse proxy, set its public origin.
ALLOWED_ORIGINS=
MAX_CONNECTIONS=512
MAX_CONNECTIONS_PER_IP=64
# Multiplayer seats; solo and menu visitors do not consume these slots.
MAX_PLAYERS=200
MAX_WAITING_PLAYERS=10000
# Docker Compose settings. The default publishes only on this computer.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
